# The application's settings: copy to .env.local and fill in.
NODE_ENV=development
export PORT=3000
DEBUG=true
RATIO = 0.75
APP_NAME=My App   # spaces inside an unquoted value are kept
API_URL=https://api.example.com/v1?x=1&y=2
GREETING="Hello, ${USER:-friend}!\nWelcome to $APP_NAME."
QUOTED='literal $HOME and \n stay as they are'
SCRIPT=`echo hi`
PRIVATE_KEY="-----BEGIN KEY-----
line two
-----END KEY-----"
PRICE=5$ and \$HOME
HOME_DIR=$HOME/app
CACHE=${XDG_CACHE_HOME}/app
EMPTY=
MESSAGE=it's fine
export=1
vite.port=5173
NODE_ENV=production
